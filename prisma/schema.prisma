generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  EM_ATENDIMENTO
  ENCERRADO
  CANCELADO
}

enum MotivoEncerramento {
  NAO_CONFIRMADO
  NAO_LOCALIZADO
  DESISTENCIA
  FALTA_PRIMEIRA_SESSAO
  TRES_FALTAS
  CANCELADO_PELO_PACIENTE
  CANCELADO_PELO_ESTAGIARIO
  TRANSFERENCIA
  ALTA
  FIM_DO_PERIODO
}

enum Presenca {
  PRESENTE
  FALTA
  FALTA_JUSTIFICADA
}

enum TipoEvento {
  CRIADO
  CONFIRMADO
  CANCELADO
  REMARCADO
  FALTA
  TERMO_ASSINADO
  TRANSFERIDO
  ENCERRADO
}

enum StatusListaEspera {
  AGUARDANDO
  CHAMADO
  REMOVIDO
}

enum Turno {
  MANHA
  TARDE
}

model Unidade {
  id              String   @id @default(cuid(2))
  nome            String   @unique
  ativa           Boolean  @default(true)
  horaAbertura    Int      @default(480)
  horaFechamento  Int      @default(1260)
  duracaoBlocoMin Int      @default(50)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  equipes            Equipe[]
  periodos           PeriodoLetivo[]
  usuarios           UsuarioUnidade[]
  salas              Sala[]
  agendamentos       Agendamento[]
  listaEspera        ListaEspera[]
  solicitacoesAcesso SolicitacaoAcesso[]
}

model Equipe {
  id           String   @id @default(cuid(2))
  unidadeId    String
  nome         String
  supervisorId String?
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  unidade                  Unidade                             @relation(fields: [unidadeId], references: [id])
  supervisor               Usuario?                            @relation("SupervisorDaEquipe", fields: [supervisorId], references: [id])
  vinculoSupervisor        UsuarioEquipe?                      @relation("SupervisorResponsavel", fields: [supervisorId, id, unidadeId], references: [usuarioId, equipeId, unidadeId], onDelete: NoAction, onUpdate: NoAction)
  membros                  UsuarioEquipe[]                     @relation("MembrosDaEquipe")
  configuracoesAtendimento ConfiguracaoAtendimentoEstagiario[]
  agendamentos             Agendamento[]
  listaEspera              ListaEspera[]

  @@unique([unidadeId, nome])
  @@unique([id, unidadeId])
  @@unique([supervisorId, id, unidadeId])
}

model PeriodoLetivo {
  id        String   @id @default(cuid(2))
  unidadeId String
  inicio    DateTime @db.Date
  fim       DateTime @db.Date

  unidade                  Unidade                             @relation(fields: [unidadeId], references: [id])
  configuracoesAtendimento ConfiguracaoAtendimentoEstagiario[]

  @@unique([id, unidadeId])
  @@index([unidadeId, inicio, fim])
}

model ConfiguracaoAtendimentoEstagiario {
  estagiarioId    String
  equipeId        String
  unidadeId       String
  periodoLetivoId String

  liberado        Boolean  @default(false)
  limitePacientes Int      @default(0)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  estagiario Usuario @relation("ConfiguracoesDoEstagiario", fields: [estagiarioId], references: [id], onDelete: Cascade)
  equipe     Equipe  @relation(fields: [equipeId, unidadeId], references: [id, unidadeId], onDelete: Cascade)

  vinculoEquipe UsuarioEquipe @relation(fields: [estagiarioId, equipeId, unidadeId], references: [usuarioId, equipeId, unidadeId], onDelete: Cascade)
  periodoLetivo PeriodoLetivo @relation(fields: [periodoLetivoId, unidadeId], references: [id, unidadeId], onDelete: Cascade)

  @@id([estagiarioId, equipeId, periodoLetivoId])
  @@index([equipeId, periodoLetivoId, liberado])
}

model Sala {
  id        String   @id @default(cuid(2))
  unidadeId String
  nome      String
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  unidade          Unidade               @relation(fields: [unidadeId], references: [id])
  agendamentos     Agendamento[]
  disponibilidades SalaDisponibilidade[]

  @@unique([unidadeId, nome])
}

model SalaDisponibilidade {
  id         String   @id @default(cuid(2))
  salaId     String
  diaSemana  Int
  horaInicio Int
  horaFim    Int
  criadoEm   DateTime @default(now())

  sala Sala @relation(fields: [salaId], references: [id], onDelete: Cascade)

  @@index([salaId, diaSemana])
}

model PreferenciaEstagiario {
  estagiarioId String
  diaSemana    Int
  turno        Turno
  criadoEm     DateTime @default(now())

  estagiario Usuario @relation(fields: [estagiarioId], references: [id], onDelete: Cascade)

  @@id([estagiarioId, diaSemana, turno])
}

model Paciente {
  id              String   @id @default(cuid(2))
  nome            String
  cpf             String   @unique
  dataNascimento  DateTime @db.Date
  telefone        String
  email           String
  responsavelNome String?
  responsavelCpf  String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  agendamentos     Agendamento[] @relation("PacienteDoAgendamento")
  agendamentoAtivo Agendamento?  @relation("PacienteComAgendamentoAtivo")
  listaEspera      ListaEspera[] @relation("PacienteDaLista")
  posicaoAtiva     ListaEspera?  @relation("PacienteNaListaAtiva")
}

model Agendamento {
  id                   String              @id @default(cuid(2))
  unidadeId            String
  equipeId             String
  estagiarioId         String
  salaId               String
  pacienteId           String
  listaEsperaId        String?
  diaSemana            Int
  horaInicio           Int
  status               StatusAgendamento   @default(PENDENTE)
  dataInicio           DateTime            @db.Date
  dataFim              DateTime            @db.Date
  prazoConfirmacao     DateTime
  confirmadoEm         DateTime?
  termoAssinadoEm      DateTime?
  motivoEncerramento   MotivoEncerramento?
  encerradoEm          DateTime?
  criadoPorId          String?
  criadoEm             DateTime            @default(now())
  estagiarioAtivoChave String?             @unique
  salaAtivaChave       String?             @unique
  pacienteAtivoId      String?             @unique

  unidade       Unidade             @relation(fields: [unidadeId], references: [id])
  equipe        Equipe              @relation(fields: [equipeId], references: [id])
  estagiario    Usuario             @relation("EstagiarioDoAgendamento", fields: [estagiarioId], references: [id])
  sala          Sala                @relation(fields: [salaId], references: [id])
  paciente      Paciente            @relation("PacienteDoAgendamento", fields: [pacienteId], references: [id])
  pacienteAtivo Paciente?           @relation("PacienteComAgendamentoAtivo", fields: [pacienteAtivoId], references: [id])
  listaEspera   ListaEspera?        @relation(fields: [listaEsperaId], references: [id])
  criadoPor     Usuario?            @relation("CriadorDoAgendamento", fields: [criadoPorId], references: [id])
  sessoes       Sessao[]
  eventos       EventoAgendamento[]

  @@index([unidadeId, status])
  @@index([estagiarioId, status])
  @@index([status, prazoConfirmacao])
  @@index([pacienteId])
}

model Sessao {
  id              String   @id @default(cuid(2))
  agendamentoId   String
  data            DateTime @db.Date
  presenca        Presenca
  registradoPorId String
  criadoEm        DateTime @default(now())

  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id])
  registradoPor Usuario     @relation(fields: [registradoPorId], references: [id])

  @@unique([agendamentoId, data])
}

model EventoAgendamento {
  id            String     @id @default(cuid(2))
  agendamentoId String
  tipo          TipoEvento
  usuarioId     String?
  observacao    String?
  criadoEm      DateTime   @default(now())

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id])
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id])

  @@index([agendamentoId, criadoEm])
}

model ListaEspera {
  id              String            @id @default(cuid(2))
  unidadeId       String
  equipeId        String
  estagiarioId    String
  designadoPorId  String
  pacienteId      String
  status          StatusListaEspera @default(AGUARDANDO)
  inscritoEm      DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt
  pacienteAtivoId String?           @unique

  unidade       Unidade       @relation(fields: [unidadeId], references: [id])
  equipe        Equipe        @relation(fields: [equipeId], references: [id])
  estagiario    Usuario       @relation("EstagiarioDaLista", fields: [estagiarioId], references: [id])
  designadoPor  Usuario       @relation("DesignadorDaLista", fields: [designadoPorId], references: [id])
  paciente      Paciente      @relation("PacienteDaLista", fields: [pacienteId], references: [id])
  pacienteAtivo Paciente?     @relation("PacienteNaListaAtiva", fields: [pacienteAtivoId], references: [id])
  agendamentos  Agendamento[]

  @@index([equipeId, status, inscritoEm])
  @@index([estagiarioId, status, inscritoEm])
  @@index([unidadeId, status])
}
